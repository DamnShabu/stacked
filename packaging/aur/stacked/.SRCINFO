pkgbase = stacked
	pkgdesc = Roblox's official Android build, run natively on Linux -- Stacked ships no Roblox code and fetches a signature-verified one
	pkgver = 0.21.2
	pkgrel = 1
	url = https://github.com/DamnShabu/stacked
	install = stacked.install
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = cargo
	makedepends = cmake
	makedepends = clang
	makedepends = pkgconf
	makedepends = libpipewire
	makedepends = libpulse
	makedepends = alsa-lib
	depends = gtk4
	depends = libadwaita
	depends = webkitgtk-6.0
	depends = zlib
	depends = glib2
	depends = pango
	depends = graphene
	depends = libsoup3
	depends = libgcc
	depends = libstdc++
	depends = glibc
	depends = vulkan-icd-loader
	depends = wayland
	depends = libxkbcommon
	depends = libglvnd
	depends = pipewire
	depends = hicolor-icon-theme
	depends = deno
	optdepends = bubblewrap: kernel sandbox under the plugin runtime
	optdepends = libx11: X11 session fallback
	optdepends = libxinerama: CORDIAL_MONITOR monitor selection under X11
	optdepends = sober: a Roblox build for Stacked to run (Stacked ships none)
	conflicts = stacked-git
	conflicts = cordial
	conflicts = cordial-git
	conflicts = cordial-bin
	options = !lto
	source = stacked::git+https://github.com/DamnShabu/stacked.git#tag=v0.21.2
	source = mcpelauncher-linker::git+https://github.com/minecraft-linux/mcpelauncher-linker.git
	source = android_bionic::git+https://github.com/minecraft-linux/android_bionic.git
	source = android_core::git+https://github.com/minecraft-linux/android_core.git
	source = libjnivm::git+https://github.com/ChristopherHX/libjnivm.git
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = stacked
