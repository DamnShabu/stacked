#!/usr/bin/env bash
# The AppImage's entry point. appimagetool runs this in place of the
# executable named in the desktop file, with the mounted (or extracted)
# AppDir as the working directory.
#
# Everything here exists to answer one question: once `stacked` is moved
# off the machine it was built on, how does it find the things it needs that
# are not DT_NEEDED entries and so were not swept up by linuxdeploy's
# dependency walk in build-appimage.sh? Each export below is one such thing.
set -euo pipefail

APPDIR="${APPDIR:-$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"

# Bundled libraries ahead of the host's own. The whole reason this AppImage
# exists rather than a bare tarball of the two binaries is that the host's
# gtk4/libadwaita can be older than what this workspace builds against, and
# the failure mode for an ordinary build against an old system library is
# three *-sys build scripts refusing to configure. The margin is wider than
# it was -- ADR-032 brought the floor down to gtk4 4.12 and libadwaita 1.5,
# so far fewer hosts are below it than when this said 4.22/1.9 -- but a
# bundled copy is what makes the margin irrelevant rather than merely large.
# An AppImage sidesteps that only if it actually carries its own copies
# rather than linking the host's, which is what this line is for.
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${LD_LIBRARY_PATH:-}"

# GSettings schemas are found by path lookup through GIO, not through a
# symbol linuxdeploy's ELF dependency walk can see -- nothing in
# `stacked` references the schema directory by name, so nothing about it
# survives an ordinary --executable bundling pass. build-appimage.sh compiles
# a copy into usr/share/glib-2.0/schemas for exactly this reason.
export GSETTINGS_SCHEMA_DIR="${APPDIR}/usr/share/glib-2.0/schemas"

export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# ---------------------------------------------------------------------------
# WebKitGTK's absolute paths
#
# WebKitGTK spawns its helper processes (WebKitNetworkProcess,
# WebKitWebProcess, WebKitGPUProcess) and loads its injected bundle from a
# directory compiled into libwebkitgtk-6.0.so, and runs its web process
# sandbox through /usr/bin/bwrap and /usr/bin/xdg-dbus-proxy, also by absolute
# path. A spawn that fails is not an error it returns: it calls g_error and
# the whole client goes with it.
#
# **This block used to make the helper directory exist with a mount
# namespace, and that was the wrong place for it.** It bound Fedora's
# /usr/libexec/webkitgtk-6.0, then Ubuntu's /usr/lib/x86_64-linux-gnu one
# only where that parent already existed -- so on Arch, Fedora and NixOS it
# bound nothing for the library actually bundled since ADR-032. And the Roblox
# manager never runs this file at all: it execs usr/bin/cordial-run directly,
# inside its own Flatpak, where a namespace cannot be made (measured
# 2026-10-01: bwrap there says "No permissions to create a new namespace").
# v0.21.3 aborted the client on "Servers" there, `Failed to spawn child
# process "/usr/lib/x86_64-linux-gnu/webkitgtk-6.0/WebKitNetworkProcess"`.
#
# The build now rewrites that directory string in the bundled library and the
# client copies the helpers to it before its first web view, wherever it was
# started from -- build-appimage.sh, crates/cordial-shell/src/webkit_helpers.rs
# and ADR-045. Nothing here is needed for it.
#
# Kept: WEBKIT_INJECTED_BUNDLE_PATH, whose name is present in the library
# (WEBKIT_EXEC_PATH is not -- it is read only in developer builds -- and is
# exported only because the manager's launcher sets it too and the two should
# not differ). The bundle it names is under usr/lib, which WebKit's sandbox
# binds because it is on LD_LIBRARY_PATH.
export WEBKIT_EXEC_PATH="${APPDIR}/usr/libexec/webkitgtk-6.0"
export WEBKIT_INJECTED_BUNDLE_PATH="${APPDIR}/usr/lib/webkitgtk-6.0/injected-bundle"

# What is left for a namespace to do is the sandbox tools, on a host that has
# no /usr/bin/bwrap or /usr/bin/xdg-dbus-proxy: overlay /usr/bin, writes going
# to an invisible tmpfs, and bind the bundled copies in under those names.
# Without them the client refuses to open a web view and says which is
# missing, rather than letting WebKit abort it.
#
# The overlay needs bwrap 0.11 or later. The bundled one is Ubuntu 24.04's
# 0.9.0, which answers `Unknown option --overlay-src` (measured 2026-10-01),
# so a host bwrap is tried first and the bundled one last. On a host with no
# bwrap at all this cannot happen, and the client's refusal is what remains.
#
# Measured on 2026-09-02 against the Fedora-built image: the namespace keeps
# the real uid and the shared pid namespace (so `pidof cordial-run`, lldb and
# the development MCP still reach the client), and /dev/dri, the Wayland
# socket, the session bus and flock all still work through it. Overlayfs
# refuses a lowerdir that is itself an overlay or has a submount inside it,
# which is what the probe below is for.
#
# CORDIAL_APPIMAGE_NO_WRAP=1 skips it; CORDIAL_APPIMAGE_WRAPPED is the
# recursion guard and is set by the re-exec, not by a user.
plant=()
for tool in bwrap xdg-dbus-proxy; do
    if [ ! -x "/usr/bin/$tool" ] && [ -x "${APPDIR}/usr/bin/$tool" ]; then
        plant+=("$tool")
    fi
done
if [ -z "${CORDIAL_APPIMAGE_WRAPPED:-}" ] \
   && [ -z "${CORDIAL_APPIMAGE_NO_WRAP:-}" ] \
   && [ ${#plant[@]} -gt 0 ] && [ -d /usr/bin ]; then
    for bwrap in /usr/bin/bwrap "$(command -v bwrap 2>/dev/null || true)" "${APPDIR}/usr/bin/bwrap"; do
        [ -n "$bwrap" ] && [ -x "$bwrap" ] || continue

        args=(--dev-bind / / --die-with-parent
              --overlay-src /usr/bin --tmp-overlay /usr/bin)
        for tool in "${plant[@]}"; do
            args+=(--ro-bind "${APPDIR}/usr/bin/$tool" "/usr/bin/$tool")
        done

        # Probe with the real argument list, so a bwrap too old for
        # --overlay-src, or a kernel that refuses unprivileged overlayfs, is
        # caught here and the next candidate tried, instead of aborting the
        # launch. The probe runs this shell rather than /bin/true, which
        # NixOS does not have -- with /bin/true every probe there failed.
        "$bwrap" "${args[@]}" -- "$BASH" -c : >/dev/null 2>&1 || continue

        export CORDIAL_APPIMAGE_WRAPPED=1
        exec "$bwrap" "${args[@]}" -- "${APPDIR}/AppRun" "$@"
    done
fi


exec "${APPDIR}/usr/bin/stacked" "$@"
